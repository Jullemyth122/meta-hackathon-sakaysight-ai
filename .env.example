# ---- Server-only (Vercel /api). Never prefix these with VITE_. ----
META_API_KEY=
# OpenAI-compatible Meta endpoint: this is the default, so set it only to use another.
META_API_BASE=https://api.meta.ai/v1
# The Muse model ID from the hackathon portal: muse-wonder-1.0 is the newest (muse-spark-1.3 costs less).
META_MODEL=
# Optional. A reading voice that speaks Filipino (see api/speak.ts).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. true answers from the planner only: no Meta credit spent at all.
META_SAVE_CREDITS=
# Optional. Other sites allowed to call /api, comma separated (api/_lib/guard.ts).
ALLOWED_ORIGINS=

# ---- Client (bundled into the browser; these are public by design). ----
# Firebase web config: Firebase console > Project settings > Your apps > Web app.
# Without the VITE_ prefix works too (src/config.ts).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# webgpu | webgl. WebGPU falls back to WebGL2 automatically when unsupported.
VITE_RENDERER=webgpu
# Vector tiles for the 3D map (OpenMapTiles schema). Default: OpenFreeMap, free, no key.
# Set to "off" to run without the map (e.g. fully offline).
VITE_MAP_TILEJSON=https://tiles.openfreemap.org/planet
